# ---- Database (Supabase: Project Settings -> Database -> Connection string) ----
# DATABASE_URL = "Transaction pooler" URI (port 6543) with ?pgbouncer=true
# DIRECT_URL   = "Session pooler" / direct URI (port 5432)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ---- Security ----
# Any long random string (run: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Your SaaS ----
NEXT_PUBLIC_APP_NAME="Restaurant Manager"
# Super admins (comma separated). They log in at /admin/login with a code sent to this email.
SUPERADMIN_EMAILS="you@example.com"

# ---- Email for the login codes (any SMTP provider) ----
# Gmail: smtp.gmail.com, port 465, your address + an App Password (Google Account -> Security -> App passwords)
# Leave SMTP_HOST empty in local development: the code is printed in the terminal instead.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Restaurant Manager <you@example.com>"

# ---- Optional: demo restaurant created by `npm run db:seed -- --demo` ----
OWNER_NAME="Your Name"
OWNER_USERNAME="owner"
OWNER_PASSWORD="choose-a-strong-password"
